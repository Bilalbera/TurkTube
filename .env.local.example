# ─────────────────────────────────────────────────────────────
# TürkTube ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayın ve Supabase panelinden
# "Project Settings > API" bölümündeki değerleri girin.
# .env.local dosyası ASLA git'e eklenmemelidir.
# ─────────────────────────────────────────────────────────────

# Supabase proje adresi  (örn: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) anahtarı - RLS ile korunur, güvenlidir
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uygulamanın kendi adresi (e-posta doğrulama yönlendirmeleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
